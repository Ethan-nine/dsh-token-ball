{
  "name": "@local/dsh-token-ball",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A draggable floating ball for live conversation tokens, estimated cost, context pressure, and DeepSeek account balance.",
  "license": "MIT",
  "author": "Ethan-nine",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "token-usage",
    "cost-tracking",
    "context-window",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ethan-nine/dsh-token-ball.git"
  },
  "homepage": "https://github.com/Ethan-nine/dsh-token-ball#readme",
  "bugs": {
    "url": "https://github.com/Ethan-nine/dsh-token-ball/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cost.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
